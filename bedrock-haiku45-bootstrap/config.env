# Region must support Haiku 4.5 (ap-southeast-2 is listed as supported)
AWS_REGION="ap-southeast-2"
AWS_DEFAULT_REGION="ap-southeast-2"

# Your IAM user
USER_NAME="matt"

# Claude Haiku 4.5 Bedrock model ID
MODEL_ID="au.anthropic.claude-haiku-4-5-20251001-v1:0"

# Prompt for the bootstrap invocation
PROMPT_TEXT="Say hello in one short sentence."

# Optional: If you want scripts to use a named AWS CLI profile
USE_PROFILE=0
AWS_PROFILE="default"

# Optional (advanced): If you *already have* an Anthropic use-case form blob file to submit via CLI
# (Most people will do this once in the Bedrock console instead.)
USECASE_FORM_FILE=""
